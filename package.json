{
  "name": "envis-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DENR-EMB Region VII Environmental Permits Monitoring Dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:fetch": "node scripts/fetch-sheets.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:spatial": "node scripts/build-spatial.mjs",
    "data:legal": "node scripts/build-legal.mjs",
    "data:legal:check": "node scripts/build-legal.mjs --check",
    "data:all": "npm run data:fetch && npm run data:spatial && npm run data:build && npm run data:legal",
    "live": "node scripts/serve-live.mjs",
    "live:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action status",
    "live:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action restart",
    "live:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action install",
    "live:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live.ps1 -Action uninstall",
    "refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action run",
    "refresh:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action install",
    "refresh:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action status",
    "refresh:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh.ps1 -Action uninstall"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "echarts": "5.6.0",
    "echarts-for-react": "3.0.2",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "0.474.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.16",
    "@types/leaflet.markercluster": "1.5.5",
    "@types/node": "22.10.7",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "mapshaper": "0.6.102",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
